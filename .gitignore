# ___ Virtual environment ___
# Large, specifi to machine, and rebuilt from requirements.txt
.venv/
venv

# ___ Python cache ___
# Created automatically when Python runs code
__pycache__/
*.py[cod]

# ___ Secrets and local settings ___
# Never push passwords or API keys to Github
.env
.env.*
!.env.example

# ___ Trained models ___
# Large and can be regenerated by running the training script
/models/*.joblib

# ___ Jupyter ___
# Autosave copies Jupyter makes next to notebooks
.ipynb_checkpoints/

# ___ Testing and packaging ___
.pytest_cache/
*.egg-info/
build/
dist/

# ___ Editors and OS ___
.vscode/
.idea/
.DS_Store